---
import { Image } from 'astro:assets';
import heroPortrait from '../assets/HERO.webp';

export interface Props {
  title: string
  subtitle: string
  ctaText: string
  ctaLink: string
  secondaryCtaText?: string
  secondaryCtaLink?: string
  badge?: string
  portraitImage?: { alt: string }
}

const {
  title,
  subtitle,
  ctaText,
  ctaLink,
  secondaryCtaText,
  secondaryCtaLink,
  badge,
  portraitImage,
} = Astro.props
---

<section class="min-h-[100svh] flex items-center justify-center px-6 relative overflow-hidden bg-bg-alt">
  <div class="absolute inset-0 z-0 bg-gradient-to-br from-primary-50 via-bg-alt to-primary-100 opacity-60"></div>
  <div class="absolute top-20 right-20 w-72 h-72 bg-primary-200/30 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-20 w-64 h-64 bg-accent-200/20 rounded-full blur-3xl"></div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-16 items-center">
      <!-- Portrait Image (Desktop: left, Mobile: hidden or above) -->
      {portraitImage && (
        <div class="hidden lg:block order-2 lg:order-1">
          <Image
            src={heroPortrait}
            alt={portraitImage.alt}
            width={400}
            height={600}
            class="w-full max-w-md mx-auto lg:mx-0 drop-shadow-2xl"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            quality={80}
            format="avif"
          />
        </div>
      )}

      <!-- Content -->
      <div class="text-center lg:text-left order-1 lg:order-2">
        {badge && (
          <span class="inline-block px-5 py-2 mb-8 text-sm font-semibold text-primary-600 bg-primary-100 rounded-full border border-primary-200 tracking-wide uppercase">
            {badge}
          </span>
        )}
        <h1 class="text-4xl md:text-6xl font-heading font-bold text-text-main mb-6 leading-tight">
          {title}
        </h1>
        <p class="text-lg md:text-xl text-text-muted mb-10 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          {subtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href={ctaLink} class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            {ctaText}
          </a>
          {secondaryCtaText && secondaryCtaLink && (
            <a href={secondaryCtaLink} class="btn-secondary">
              {secondaryCtaText}
            </a>
          )}
        </div>

        <div class="mt-16 flex flex-wrap justify-center lg:justify-start gap-8 text-text-muted text-sm">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cta-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Sin compromiso
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cta-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Respuesta en 2h
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cta-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Primera consulta gratis
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-bg-surface to-transparent z-10"></div>
</section>
