---
export interface BulletPoint {
  icon: string
  text: string
}

export interface Props {
  problemTitle: string
  solutionTitle: string
  problems: BulletPoint[]
  solutions: BulletPoint[]
}

const { problemTitle, solutionTitle, problems, solutions } = Astro.props
---

<section class="section-padding section-divider bg-bg-surface relative">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-14 reveal">
      <span class="inline-block px-4 py-1.5 mb-4 text-xs font-semibold text-primary-600 bg-primary-50 rounded-full border border-primary-100 uppercase tracking-wider">El problema y la solucion</span>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-text-main">Por que elegirnos</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-12 lg:gap-20">
      <div class="reveal p-8 md:p-10 rounded-2xl border border-red-100 bg-gradient-to-br from-red-50/40 to-transparent">
        <div class="flex items-center gap-3 mb-8">
          <span class="w-11 h-11 rounded-xl bg-red-100 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          </span>
          <h3 class="text-xl md:text-2xl font-heading font-bold text-text-main">{problemTitle}</h3>
        </div>
        <ul class="space-y-5">
          {problems.map((p) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 w-5 h-5 text-red-400 flex-shrink-0" set:html={p.icon} />
              <span class="text-text-muted leading-relaxed">{p.text}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="reveal p-8 md:p-10 rounded-2xl border border-green-100 bg-gradient-to-br from-green-50/40 to-transparent">
        <div class="flex items-center gap-3 mb-8">
          <span class="w-11 h-11 rounded-xl bg-cta-50 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cta-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </span>
          <h3 class="text-xl md:text-2xl font-heading font-bold text-text-main">{solutionTitle}</h3>
        </div>
        <ul class="space-y-5">
          {solutions.map((s) => (
            <li class="flex items-start gap-3">
              <span class="mt-1 w-5 h-5 text-cta-500 flex-shrink-0" set:html={s.icon} />
              <span class="text-text-muted leading-relaxed">{s.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
