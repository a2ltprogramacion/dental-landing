---
export interface NavLink {
  label: string;
  href: string;
}

export interface SocialLink {
  platform: string;
  url: string;
  icon: string;
}

export interface Props {
  companyName: string;
  tagline?: string;
  links: NavLink[];
  socialLinks?: SocialLink[];
  address?: string;
  phone?: string;
  email?: string;
}

const {
  companyName,
  tagline,
  links,
  socialLinks = [],
  address,
  phone,
  email,
} = Astro.props;
---

<footer class="section-padding bg-bg-dark text-white relative overflow-hidden">
  <div
    class="absolute inset-0 bg-gradient-to-b from-bg-dark to-primary-900/20 z-0"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      <div class="md:col-span-1">
        <div class="flex items-start gap-3">
          <img
            src="/images/logo-diente.webp"
            alt="BrightSmile"
            class="w-15 h-15 flex-shrink-0"
            width="40"
            height="40"
          />
          <div>
            <h3 class="text-xl font-heading font-bold text-white mb-3">
              {companyName}
            </h3>
            {
              tagline && (
                <p class="text-primary-200 text-sm leading-relaxed">
                  {tagline}
                </p>
              )
            }
          </div>
        </div>
      </div>

      <div>
        <h4
          class="font-heading font-semibold text-primary-200 text-sm uppercase tracking-wider mb-4"
        >
          Navegacion
        </h4>
        <nav class="flex flex-col gap-3">
          {
            links.map((link) => (
              <a
                href={link.href}
                class="text-white/70 hover:text-white transition-colors text-sm"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div>
        <h4
          class="font-heading font-semibold text-primary-200 text-sm uppercase tracking-wider mb-4"
        >
          Contacto
        </h4>
        <div class="space-y-3 text-sm text-white/70">
          {
            address && (
              <p class="flex items-start gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 mt-0.5 text-primary-300 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </>
                </svg>
                {address}
              </p>
            )
          }
          {
            phone && (
              <p class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-primary-300 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  />
                </svg>
                {phone}
              </p>
            )
          }
          {
            email && (
              <p class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4 text-primary-300 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
                {email}
              </p>
            )
          }
        </div>
      </div>

      <div>
        <h4
          class="font-heading font-semibold text-primary-200 text-sm uppercase tracking-wider mb-4"
        >
          Redes
        </h4>
        <div class="flex gap-3">
          {
            socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white/70 hover:text-white hover:border-primary-400 hover:bg-primary-500/20 transition-all cursor-pointer"
                aria-label={social.platform}
              >
                <span class="w-5 h-5" set:html={social.icon} />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-white/40 text-sm">
        &copy; {new Date().getFullYear()}
        {companyName}. Todos los derechos reservados.
      </p>
      <p class="text-white/30 text-xs">
        Desarrollado por <a
          href="https://a2lt.netlify.app"
          class="hover:text-primary-300 transition-colors"
          target="_blank"
          rel="noopener noreferrer">A2LT Soluciones</a
        >
      </p>
    </div>
  </div>
</footer>
