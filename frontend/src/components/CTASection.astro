---
import { Image } from "astro:assets";
import ctaAccent from "../assets/CTA_ACCENT.webp";

export interface Props {
  title: string;
  description: string;
  buttonText: string;
  buttonLink: string;
  microcopy?: string;
  accentImage?: { alt: string };
}

const { title, description, buttonText, buttonLink, microcopy, accentImage } =
  Astro.props;
---

<section class="section-padding bg-primary-500 relative overflow-hidden">
  <div
    class="absolute inset-0 bg-gradient-to-r from-primary-600 to-primary-500 z-0"
  >
  </div>
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-primary-400/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-80 h-80 bg-primary-300/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/3"
  >
  </div>
  <div
    class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"
  >
  </div>

  <div class="relative z-10 max-w-3xl mx-auto text-center reveal">
    <span
      class="inline-block px-4 py-1.5 mb-6 text-xs font-semibold text-white bg-white/15 rounded-full border border-white/20 uppercase tracking-wider"
      >No esperes mas</span
    >
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6 shimmer-text">
      {title}
    </h2>
    <p class="text-lg text-primary-100 mb-10 leading-relaxed">{description}</p>
    <a
      href={buttonLink}
      class="btn-primary bg-white text-primary-700 hover:bg-primary-50"
    >
      {buttonText}
    </a>
    {microcopy && <p class="mt-6 text-primary-200 text-sm">{microcopy}</p>}
  </div>

  <!-- Accent Image: subtle clinical detail overlay -->
  {
    accentImage && (
      <div
        class="absolute bottom-0 right-0 w-64 h-64 md:w-160 md:h-160 opacity-15 pointer-events-none"
        aria-hidden="true"
      >
        <Image
          src={ctaAccent}
          alt={accentImage.alt}
          width={300}
          height={300}
          class="w-full h-full object-contain"
          loading="lazy"
          decoding="async"
          quality={80}
          format="avif"
        />
      </div>
    )
  }
</section>
