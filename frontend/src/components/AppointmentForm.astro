---
export interface Props {
  sectionTitle?: string
  sectionSubtitle?: string
}

const {
  sectionTitle = "Agenda tu Cita",
  sectionSubtitle = "Selecciona el servicio y reserva tu horario directamente",
} = Astro.props

const calEvents = [
  { id: "general", label: "General", icon: "tooth", link: "https://cal.com/angel-leon-nmbwot/general" },
  { id: "ortodoncia", label: "Ortodoncia", icon: "braces", link: "https://cal.com/angel-leon-nmbwot/ortodoncia" },
  { id: "estetica", label: "Estetica", icon: "star", link: "https://cal.com/angel-leon-nmbwot/estetica" },
  { id: "implantes", label: "Implantes", icon: "implant", link: "https://cal.com/angel-leon-nmbwot/implantes" },
]

const icons: Record<string, string> = {
  tooth: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2C9.5 2 7 3.5 7 7c0 2.5 1 4 2 5.5S11 16 11 20c0 1.1.9 2 2 2s2-.9 2-2c0-4-.5-6 1-7.5S18 9.5 18 7c0-3.5-2.5-5-5-5h-1z" /></svg>',
  braces: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>',
  star: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>',
  implant: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 6H9L8 4z" /></svg>',
}
---

<section id="agenda" class="bg-bg-surface relative" style="padding: 2.5rem 1rem;">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-primary-300 to-transparent opacity-40"></div>

  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-5 reveal">
      <span class="section-label text-primary-600 bg-primary-50 border border-primary-100">Comienza ahora</span>
      <h2 class="text-2xl md:text-4xl font-heading font-bold text-text-main mb-2 shimmer-text">{sectionTitle}</h2>
      <p class="text-sm text-text-muted">{sectionSubtitle}</p>
    </div>

    <div class="reveal">
      <div class="grid md:grid-cols-[220px_1fr] gap-4 md:gap-8">
        <div class="md:pt-2">
          <p class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-2 hidden md:block">Servicio</p>
          <div id="cal-tabs" class="grid grid-cols-2 md:grid-cols-1 gap-2 md:overflow-visible pb-1 md:pb-0">
            {calEvents.map((evt, i) => (
              <button
                data-cal-id={evt.id}
                data-cal-link={evt.link}
                class={`cal-tab flex items-center gap-2 px-2.5 py-2 md:px-4 md:py-2.5 rounded-xl border font-heading font-semibold text-xs md:text-sm transition-all duration-200 cursor-pointer whitespace-nowrap justify-center md:justify-start ${i === 0 ? "border-primary-500 bg-primary-50 text-primary-700 shadow-sm" : "border-border bg-bg-surface text-text-muted hover:border-primary-300 hover:bg-primary-50/30"}`}
              >
                <span class={`flex-shrink-0 ${i === 0 ? "text-primary-500" : "text-text-light"}`}>
                  <Fragment set:html={icons[evt.icon]} />
                </span>
                {evt.label}
              </button>
            ))}
          </div>
        </div>

        <div class="hidden md:block bg-bg-alt rounded-2xl border border-border overflow-hidden shadow-sm">
          <div id="cal-container-desktop" class="w-full relative">
            <div id="cal-loading-desktop" class="flex items-center justify-center py-16 text-text-muted text-sm absolute inset-0 z-10">
              <svg class="animate-spin w-4 h-4 mr-2 text-primary-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Cargando calendario...
            </div>
            <iframe
              id="cal-iframe-desktop"
              src="https://cal.com/angel-leon-nmbwot/general?embed=true"
              class="w-full border-0"
              style="height: 480px; transition: opacity 0.3s ease;"
              title="Calendario de citas"
            ></iframe>
          </div>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-text-muted">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-cta-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Confirmacion por email
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Recordatorio 24h
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          Sin compromiso
        </span>
      </div>
    </div>
  </div>

  <div id="cal-modal" class="cal-modal" role="dialog" aria-modal="true" aria-label="Calendario de citas">
    <div class="cal-modal-backdrop" id="cal-modal-backdrop"></div>
    <div class="cal-modal-content">
      <div class="cal-modal-header">
        <p id="cal-modal-title" class="cal-modal-title"></p>
        <button id="cal-modal-close" class="cal-modal-close" aria-label="Cerrar calendario">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div class="cal-modal-body">
        <div id="cal-loading-mobile" class="flex items-center justify-center text-text-muted text-sm" style="padding: 8rem 0;">
          <svg class="animate-spin w-5 h-5 mr-2 text-primary-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Cargando calendario...
        </div>
        <iframe
          id="cal-iframe-mobile"
          src=""
          class="w-full border-0"
          style="height: calc(100vh - 5rem); display: none;"
          title="Calendario de citas"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .cal-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
  }
  .cal-modal.is-open {
    display: flex;
    flex-direction: column;
  }
  .cal-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 47, 46, 0.6);
    backdrop-filter: blur(4px);
  }
  .cal-modal-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background: var(--color-bg-surface);
  }
  .cal-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
    padding-top: max(0.75rem, env(safe-area-inset-top));
  }
  .cal-modal-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-text-main);
  }
  .cal-modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background 0.15s;
  }
  .cal-modal-close:hover {
    background: var(--color-bg-alt);
  }
  .cal-modal-body {
    flex: 1;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
  }
  body.cal-modal-open {
    overflow: hidden;
    position: fixed;
    width: 100%;
  }
</style>

<script>
  const CAL_EVENTS: Record<string, string> = {
    general: "https://cal.com/angel-leon-nmbwot/general",
    ortodoncia: "https://cal.com/angel-leon-nmbwot/ortodoncia",
    estetica: "https://cal.com/angel-leon-nmbwot/estetica",
    implantes: "https://cal.com/angel-leon-nmbwot/implantes",
  };

  const CAL_LABELS: Record<string, string> = {
    general: "Odontologia General",
    ortodoncia: "Ortodoncia",
    estetica: "Estetica Dental",
    implantes: "Implantologia",
  };

  const isMobile = () => window.innerWidth <= 768;

  const iframeDesktop = document.getElementById("cal-iframe-desktop") as HTMLIFrameElement;
  const loadingDesktop = document.getElementById("cal-loading-desktop");
  const iframeMobile = document.getElementById("cal-iframe-mobile") as HTMLIFrameElement;
  const loadingMobile = document.getElementById("cal-loading-mobile")!;
  const modal = document.getElementById("cal-modal")!;
  const modalBackdrop = document.getElementById("cal-modal-backdrop")!;
  const modalClose = document.getElementById("cal-modal-close")!;
  const modalTitle = document.getElementById("cal-modal-title")!;
  const tabs = document.querySelectorAll<HTMLElement>(".cal-tab");

  function openModal(id: string) {
    modalTitle.textContent = CAL_LABELS[id] || id;
    modal.classList.add("is-open");
    document.body.classList.add("cal-modal-open");
    loadingMobile.style.display = "flex";
    iframeMobile.style.display = "none";
    iframeMobile.src = `${CAL_EVENTS[id]}?embed=true`;
  }

  function closeModal() {
    modal.classList.remove("is-open");
    document.body.classList.remove("cal-modal-open");
  }

  function activateTab(id: string) {
    tabs.forEach((tab) => {
      const isActive = tab.dataset.calId === id;
      tab.classList.toggle("border-primary-500", isActive);
      tab.classList.toggle("bg-primary-50", isActive);
      tab.classList.toggle("text-primary-700", isActive);
      tab.classList.toggle("shadow-sm", isActive);
      tab.classList.toggle("border-border", !isActive);
      tab.classList.toggle("bg-bg-surface", !isActive);
      tab.classList.toggle("text-text-muted", !isActive);
      const icon = tab.querySelector("span");
      if (icon) {
        icon.classList.toggle("text-primary-500", isActive);
        icon.classList.toggle("text-text-light", !isActive);
      }
    });

    if (isMobile()) {
      openModal(id);
    } else if (iframeDesktop && loadingDesktop && CAL_EVENTS[id]) {
      loadingDesktop.style.display = "flex";
      iframeDesktop.style.opacity = "0";
      iframeDesktop.src = `${CAL_EVENTS[id]}?embed=true`;
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const calId = tab.dataset.calId;
      if (calId) activateTab(calId);
    });
  });

  if (iframeDesktop) {
    iframeDesktop.addEventListener("load", () => {
      if (loadingDesktop) loadingDesktop.style.display = "none";
      iframeDesktop.style.opacity = "1";
    });
  }

  if (iframeMobile) {
    iframeMobile.addEventListener("load", () => {
      if (loadingMobile) loadingMobile.style.display = "none";
      iframeMobile.style.display = "block";
    });
  }

  modalClose.addEventListener("click", closeModal);
  modalBackdrop.addEventListener("click", closeModal);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal.classList.contains("is-open")) closeModal();
  });
</script>
