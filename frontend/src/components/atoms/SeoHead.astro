      "url": "https://brightsmile.pages.dev",
      "telephone": "+58-412-1234567",
      "email": "info@brightsmile.com.ve",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Av. Principal, Centro Médico Las Delicias, Piso 3, Consultorio 305",
        "addressLocality": "[TU CIUDAD]",
        "addressCountry": "VE"
      },
      "geo": {
