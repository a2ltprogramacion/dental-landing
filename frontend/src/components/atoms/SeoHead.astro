        "height": 32,
        "caption": "BrightSmile"
      },
      "sameAs": [
        "https://instagram.com/brightsmile",
        "https://facebook.com/brightsmile",
        "https://wa.me/584121234567"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+58-412-1234567",
        "contactType": "customer service",
        "availableLanguage": ["Spanish", "English"],
        "areaServed": "VE"
      }
    },
    {
      "@type": "LocalBusiness",
