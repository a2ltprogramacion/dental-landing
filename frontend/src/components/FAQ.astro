---
export interface QA {
  question: string
  answer: string
}

export interface Props {
  sectionTitle: string
  questions: QA[]
}

const { sectionTitle, questions } = Astro.props
---

<section class="section-padding section-divider bg-bg-alt relative">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-4 py-1.5 mb-4 text-xs font-semibold text-primary-600 bg-primary-50 rounded-full border border-primary-100 uppercase tracking-wider">Resolvemos tus dudas</span>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-text-main">{sectionTitle}</h2>
    </div>

    <div class="space-y-5 reveal">
      {questions.map((qa) => (
        <details class="group border border-border rounded-2xl overflow-hidden bg-bg-surface hover:border-primary-200 transition-colors duration-300">
          <summary class="flex items-center justify-between p-6 md:p-7 cursor-pointer font-semibold text-text-main hover:text-primary-500 transition-colors">
            {qa.question}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-text-muted transition-transform duration-300 group-open:rotate-45 flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
          </summary>
          <div class="px-6 md:px-7 pb-6 md:pb-7 text-text-muted leading-relaxed border-t border-border/50 pt-4">{qa.answer}</div>
        </details>
      ))}
    </div>
  </div>
</section>
