---
export interface Service {
  icon: string
  title: string
  description: string
  ctaText?: string
  ctaLink?: string
}

export interface Props {
  sectionTitle: string
  sectionSubtitle?: string
  services: Service[]
}

const { sectionTitle, sectionSubtitle, services } = Astro.props
---

<section class="section-padding section-divider bg-bg-surface relative">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-4 py-1.5 mb-4 text-xs font-semibold text-primary-600 bg-primary-50 rounded-full border border-primary-100 uppercase tracking-wider">Que ofrecemos</span>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-text-main mb-4">{sectionTitle}</h2>
      {sectionSubtitle && <p class="text-lg text-text-muted max-w-2xl mx-auto">{sectionSubtitle}</p>}
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {services.map((service) => (
        <div class="reveal group p-8 md:p-10 rounded-2xl border border-border bg-bg-surface hover:shadow-lg hover:border-primary-200 transition-all duration-300 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-20 h-20 bg-primary-50/50 rounded-bl-[3rem] -translate-y-1/2 translate-x-1/2 group-hover:bg-primary-100/60 transition-colors duration-300"></div>
          <div class="relative">
            <div class="w-14 h-14 bg-primary-50 rounded-xl flex items-center justify-center mb-7 group-hover:bg-primary-100 transition-colors">
              <span class="text-primary-500" set:html={service.icon} />
            </div>
            <h3 class="text-xl font-heading font-semibold text-text-main mb-4">{service.title}</h3>
            <p class="text-text-muted leading-relaxed mb-7">{service.description}</p>
            {service.ctaText && service.ctaLink && (
              <a href={service.ctaLink} class="inline-flex items-center gap-2 text-primary-500 font-semibold text-sm hover:text-primary-600 transition-colors cursor-pointer">
                {service.ctaText}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
